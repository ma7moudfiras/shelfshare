# Copy this file to `.env` and fill in your real values.
#   cp .env.example .env
#
# `.env` is git-ignored -- never commit it.

# Your Roboflow private API key.
# Get it from: https://app.roboflow.com/settings/api
#
# MOBILE ONLY. Leave this blank for web builds: `.env` is bundled as a Flutter
# asset, so `flutter build web` publishes it to build/web/assets/.env where any
# visitor can read it. Web builds call the /api/detect proxy instead, which
# holds the key server-side as a Vercel environment variable.
# Run ./scripts/check-web-bundle.sh after a web build to verify.
ROBOFLOW_API_KEY=your_roboflow_api_key_here

# Roboflow workspace slug that owns the workflow.
ROBOFLOW_WORKSPACE=ma7mouds-workspace

# Roboflow workflow slug (NOT the workflow document id).
ROBOFLOW_WORKFLOW_ID=aystro-project

# Base URL for the Roboflow serverless inference host.
ROBOFLOW_BASE_URL=https://serverless.roboflow.com

# Model version to run, as <project>/<version>.
# The workflow itself defaults to aystro-project/1, which was trained on only
# 27 images and effectively detects just coca-cola. Point this at the newest
# trained version to pick up the other classes.
# On a web deployment the SERVER-side ROBOFLOW_MODEL_ID wins, so the model can
# be changed from the Vercel dashboard without rebuilding the app.
ROBOFLOW_MODEL_ID=aystro-project/11

# Optional. Route inference through a server-side proxy instead of calling
# Roboflow directly, so the client needs no API key. Web builds use
# /api/detect automatically; set this only to point a mobile build at a
# deployed proxy, e.g. https://your-app.vercel.app/api/detect
# ROBOFLOW_PROXY_URL=

# --- Supabase (multi-tenant backend) ---------------------------------------
# The publishable key is browser-safe by design: it grants no access on its
# own, because every table is protected by Row Level Security. It is NOT the
# service_role key, which must never appear in a client build.
SUPABASE_URL=https://dpviepymbxaibmeppylj.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_vwWcjHFmfZV40IQa5b7Smg_8YEFAyl2
