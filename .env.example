# Copy this file to `.env` and fill in your real values.
#   cp .env.example .env
#
# `.env` is git-ignored -- never commit it.

# Your Roboflow private API key.
# Get it from: https://app.roboflow.com/settings/api
ROBOFLOW_API_KEY=your_roboflow_api_key_here

# Roboflow workspace slug that owns the workflow.
ROBOFLOW_WORKSPACE=ma7mouds-workspace

# Roboflow workflow slug (NOT the workflow document id).
ROBOFLOW_WORKFLOW_ID=aystro-project

# Base URL for the Roboflow serverless inference host.
ROBOFLOW_BASE_URL=https://serverless.roboflow.com
